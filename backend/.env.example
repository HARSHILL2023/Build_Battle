# InsightFlow backend environment. Copy to .env and fill in values.
# Never commit .env to Git. Placeholders only, no secrets.

# Port for `npm run dev` / `npm run start`. Default 5000.
PORT=5000

# MongoDB connection string. Required.
MONGODB_URI=mongodb://localhost:27017/insightflow

# Allowed browser frontend origin(s), comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI (optional, for AI sentiment and topic analysis).
# When absent, the built-in deterministic analyzer is used.
OPENAI_API_KEY=

# Adaption (optional, for live Adaptive Data preparation).
# When absent, the local preparation adapter is used.
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.adaptionlabs.ai

# Session authentication (required). SESSION_SECRET signs session ids;
# generate one, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# It must be at least 32 characters and server-side only (never a VITE_* variable).
SESSION_SECRET=
# Session lifetime in hours. Default 12.
SESSION_MAX_AGE_HOURS=12
# Cookie transport. SameSite=lax suits same-site dev; cross-site
# production hosting needs none + Secure.
COOKIE_SAMESITE=lax
# true / false / auto (auto = true in production, false otherwise).
COOKIE_SECURE=auto

# Public "Try Live Demo" mode. Set false to remove the demo entry point.
DEMO_ENABLED=true
# Demo session lifetime in hours (independent of full-account sessions).
DEMO_SESSION_HOURS=2

# SQLite source path for one-off migration (`npm run migrate -- --sqlite <path>`).
# Read-only; migration never modifies the SQLite file. Not needed for normal use.
INSIGHTFLOW_DB_PATH=

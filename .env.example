# InsightFlow environment configuration.
# Copy to .env and fill in values. Never commit .env to Git.
# Only placeholders here. No secrets.

# OpenAI (optional, for AI sentiment and topic analysis).
# When absent, InsightFlow uses the built-in deterministic analyzer,
# which is clearly labeled in the UI.
OPENAI_API_KEY=

# Adaption (optional, for live Adaptive Data preparation).
# Get a key at https://adaptionlabs.ai/app. When absent, InsightFlow
# uses the clearly marked local preparation adapter.
ADAPTION_API_KEY=
# Base URL for the Adaption REST API.
ADAPTION_BASE_URL=https://api.adaptionlabs.ai

# Database file path (SQLite). Defaults to ./data/insightflow.db.
INSIGHTFLOW_DB_PATH=
